  "skip_paths": {
    "about": "SPEC.md section 5, against skip_paths below. path is as the framework gives it (with the query).",
    "skip_paths": {
      "prefixes": [
        "/static/"
      ],
      "extensions": [
        ".css",
        ".js",
        ".png",
        ".woff2"
      ]
    },
    "cases": [
      {
        "path": "/styles/site.css",
        "skip": true,
        "why": "a file by its extension"
      },
      {
        "path": "/IMG/Logo.PNG",
        "skip": true,
        "why": "extensions match whatever the case"
      },
      {
        "path": "/static/anything",
        "skip": true,
        "why": "a prefix"
      },
      {
        "path": "/static",
        "skip": false,
        "why": "the prefix needs its slash"
      },
      {
        "path": "/premium/article",
        "skip": false,
        "why": "a page"
      },
      {
        "path": "/premium/article;.css",
        "skip": false,
        "why": "matrix parameters: some servers route this to /premium/article"
      },
      {
        "path": "/premium/article%3B.css",
        "skip": false,
        "why": "an encoded ; is no better"
      },
      {
        "path": "/premium/article.css?x=1",
        "skip": true,
        "why": "the query isn't part of the path"
      },
      {
        "path": "/premium/article?file=x.css",
        "skip": false,
        "why": "an extension in the query doesn't count"
      },
      {
        "path": "/premium/..%2fx.css",
        "skip": false,
        "why": "an encoded slash after dot segments"
      },
      {
        "path": "/.css",
        "skip": false,
        "why": "nothing but the extension"
      },
      {
        "path": "/premium\\x.css",
        "skip": false,
        "why": "a backslash"
      },
      {
        "path": "/premium/article.css#frag",
        "skip": true,
        "why": "the fragment isn't part of the path"
      },
      {
        "path": "/a%2fb.css",
        "skip": false,
        "why": "any percent-encoding: a router may decode it into another page"
      },
      {
        "path": "/premium/%2e%2e/x.css",
        "skip": false,
        "why": "encoded dot segments"
      },
      {
        "path": "/premium/../x.css",
        "skip": false,
        "why": "dot segments"
      },
      {
        "path": "/images/my%20photo.png",
        "skip": false,
        "why": "encoded, so asked (a file with a space is still served, after a decision)"
      }
    ]
  },
