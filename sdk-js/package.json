{
  "name": "@stilebase/sdk",
  "version": "0.1.0",
  "description": "Charge AI agents per request with x402 (USDC on Base), settled through Stilebase. People pass straight through. Express, Cloudflare Workers, Hono, Bun, Deno.",
  "keywords": [
    "x402",
    "ai-agents",
    "crawlers",
    "paywall",
    "micropayments",
    "usdc",
    "base",
    "express",
    "middleware"
  ],
  "homepage": "https://github.com/stilebase/sdk/tree/main/sdk-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stilebase/sdk.git",
    "directory": "sdk-js"
  },
  "bugs": {
    "url": "https://github.com/stilebase/sdk/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gate": {
      "import": {
        "types": "./dist/gate/index.d.ts",
        "default": "./dist/gate/index.js"
      },
      "require": {
        "types": "./dist/gate/index.d.cts",
        "default": "./dist/gate/index.cjs"
      }
    },
    "./gate/express": {
      "import": {
        "types": "./dist/gate/express.d.ts",
        "default": "./dist/gate/express.js"
      },
      "require": {
        "types": "./dist/gate/express.d.cts",
        "default": "./dist/gate/express.cjs"
      }
    },
    "./gate/fetch": {
      "import": {
        "types": "./dist/gate/fetch.d.ts",
        "default": "./dist/gate/fetch.js"
      },
      "require": {
        "types": "./dist/gate/fetch.d.cts",
        "default": "./dist/gate/fetch.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/express": "5.0.6",
    "@types/node": "20.17.9",
    "eslint": "9.16.0",
    "express": "5.1.0",
    "globals": "15.12.0",
    "tsup": "8.5.1",
    "typescript": "5.6.3",
    "typescript-eslint": "8.17.0",
    "vitest": "4.1.11"
  }
}
